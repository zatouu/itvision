{
  "expo": {
    "name": "Xeuy Bi",
    "slug": "xeuy-consumer",
    "scheme": "xeuyconsumer",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.xeuy.xeuy",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Xeuy Bi utilise votre position pour trouver les prestataires proches.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Xeuy Bi utilise votre position pour le suivi de mission."
      }
    },
    "android": {
      "package": "com.xeuy.xeuy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-location",
      [
        "expo-av",
        {
          "microphonePermission": "Xeuy utilise le microphone pour enregistrer des messages vocaux."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F172A",
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      "sentry-expo"
    ],
    "web": {
      "bundler": "metro"
    },
    "updates": {
      "url": "https://u.expo.dev/c735fe72-f764-4847-9e1d-2342ff1cbfc8",
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "eas": {
        "projectId": "c735fe72-f764-4847-9e1d-2342ff1cbfc8"
      }
    },
    "owner": "xeuy"
  }
}
