{
  "expo": {
    "name": "Xeuy Bi Pro",
    "slug": "Xeuy-provider",
    "scheme": "xeuyprovider",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F59E0B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.xeuy.xeuypro",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Xeuy Bi utilise votre position pour vous montrer les demandes proches.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Xeuy Bi utilise votre position pour le tracking en mission."
      }
    },
    "android": {
      "package": "com.xeuy.xeuypro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F59E0B"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-location",
      "expo-av",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F59E0B",
          "sounds": [],
          "defaultChannel": "services"
        }
      ],
      "sentry-expo"
    ],
    "web": {
      "bundler": "metro"
    },
    "updates": {
      "url": "https://u.expo.dev/30c35b9c-cc94-492f-9978-a1f10809b532",
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "eas": {
        "projectId": "30c35b9c-cc94-492f-9978-a1f10809b532"
      }
    },
    "owner": "xeuy"
  }
}
