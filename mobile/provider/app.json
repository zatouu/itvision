{
  "expo": {
    "name": "Xeuy Bi Pro",
    "slug": "Xeuy-provider",
    "scheme": "xeuyprovider",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F7B4F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.xeuy.xeuypro",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Xeuy Bi utilise votre position pour vous montrer les demandes proches.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Xeuy Bi utilise votre position pour le tracking en mission.",
        "NSCameraUsageDescription": "Xeuy Bi Pro utilise l'appareil photo pour les photos KYC et les documents.",
        "NSMicrophoneUsageDescription": "Xeuy Bi Pro utilise le microphone pour les messages vocaux.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.xeuy.xeuypro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F7B4F"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-location",
      [
        "expo-av",
        {
          "microphonePermission": "Xeuy Bi Pro utilise le microphone pour enregistrer des messages vocaux."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F7B4F",
          "sounds": [],
          "defaultChannel": "services"
        }
      ],
      "./plugins/withGoogleMapsApiKey",
      [
        "./plugins/withAppName",
        {
          "appName": "Xeuy Bi Pro"
        }
      ],
      "./plugins/withGoogleServicesJson"
    ],
    "web": {
      "bundler": "metro"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD"
    },
    "extra": {
      "eas": {
        "projectId": "30c35b9c-cc94-492f-9978-a1f10809b532"
      }
    },
    "owner": "xeuy"
  }
}
