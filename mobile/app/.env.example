# Recommandé : déclarer ces variables UNE FOIS sur EAS (environnement production), lues par
# `npm run ota` et par les builds :
#   npx eas env:set --name EXPO_PUBLIC_GOOGLE_MAPS_API_KEY --value ... --environment production --visibility sensitive
# Repli : copier ce fichier en .env (non versionné) — utilisé par `npx expo start` et par
# `npm run ota` si la clé Maps n'est pas sur EAS (`eas update` ne lit PAS le bloc env d'eas.json).

# API (production). Le script OTA la reprend aussi du profil ec2 d'eas.json.
EXPO_PUBLIC_API_BASE_URL=https://itvisionplus.sn

# Clé Google Maps Android (console Google Cloud > Identifiants), restreinte au package de l'app
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry (sentry.io > Projet > Client Keys / DSN)
EXPO_PUBLIC_SENTRY_DSN=
