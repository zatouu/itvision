# Copier en .env (non versionné) avant `npm run ota` ou `npx expo start`.
# `eas update` ne lit PAS le bloc env d'eas.json : ces valeurs doivent être présentes ici.

# API (production). Le script OTA la reprend aussi du profil ec2 d'eas.json.
EXPO_PUBLIC_API_BASE_URL=https://itvisionplus.sn

# Clé Google Maps Android (console Google Cloud > Identifiants), restreinte au package de l'app
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry (sentry.io > Projet > Client Keys / DSN)
EXPO_PUBLIC_SENTRY_DSN=
